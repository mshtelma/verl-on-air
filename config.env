# =============================================================================
# Single source of truth for the Makefile. This file is `include`d by the
# Makefile (hence GNU-make $(VAR) syntax) — it is NOT a shell-sourceable env
# file. Change values here, then `make image`.
#
# The **/air/*.yaml job files intentionally carry these values LITERALLY rather
# than templating them, so any one of them can be read and submitted by hand:
#   air run --file usecases/agentic-search/air/4_train.yaml -p df1 --watch
# After changing any value below, `make retarget` rewrites every job file to match: the
# image, the /Volumes/<catalog>/<schema>/<volume> prefix, and the Vector Search endpoint and
# index (`make lint` fails while they disagree).
# =============================================================================

# ---- Databricks -------------------------------------------------------------
# `databricks auth login --host <df1-url> --profile df1` must have been run.
#
# The profile must point at a workspace with AI Runtime serverless GPU enabled.
# We target an AWS workspace because the -cu13 base images are published for AWS only,
# which matches our torch cu130 stack natively. To move back to df2, set
# AIR_PROFILE=df2 AND change the Dockerfile FROM to dcs-base-azure-runtime
# (see git history for the Azure justification chain).
AIR_PROFILE=df1

# ---- Docker Hub (private repo -> registration needs credentials) ------------
DOCKERHUB_USER=michaelshtelma587
IMAGE_NAME=verl-megatron-air
IMAGE_TAG=v9
IMAGE=$(DOCKERHUB_USER)/$(IMAGE_NAME):$(IMAGE_TAG)

# ---- Docker registry credentials for `air register image` --------------------
# A custom image must be registered before use, and a private Docker Hub repo
# needs credentials to do it. `air` stores them in a Databricks secret.
#
# Created once with the interactive flow:
#   air register image <IMAGE> -p df1        # prompts, then prints the scope/key
# Thereafter reuse them non-interactively (required in CI: the interactive form
# reads the controlling TTY and hangs without one).
#
# Leave both EMPTY to fall back to the interactive flow.
SECRET_SCOPE=msh
SECRET_KEY=dockerhubsecret

# ---- Unity Catalog ----------------------------------------------------------
UC_CATALOG=main
UC_SCHEMA=mshtelma
UC_VOLUME=verl
VOL=/Volumes/$(UC_CATALOG)/$(UC_SCHEMA)/$(UC_VOLUME)

# ---- Vector Search (agentic-search) -----------------------------------------
# The endpoint and the index the search jobs query. The index below is the one the published
# runs used; it predates versioned names -- `make search-index` builds <table>_v<hash8>_index,
# so after building your own, set VS_INDEX to the name it prints and `make retarget`.
VS_ENDPOINT=wiki-qa-vs
VS_INDEX=main.mshtelma.wiki_qa_big_corpus_index

# ---- Image size gate --------------------------------------------------------
# AI Runtime DCS rejects images >20 GB (registration replication times out).
# `make size` fails above this, so we find out locally instead of 6 min into
# `air register image`. DECIMAL GB (10^9 bytes) -- the stricter reading of the limit.
MAX_IMAGE_GB=19.5
