# =============================================================================
# Single source of truth for the Makefile. This file is `include`d by the
# Makefile (hence GNU-make $(VAR) syntax) — it is NOT a shell-sourceable env
# file. Change values here, then `make image`.
#
# The air/*.yaml files intentionally carry these values LITERALLY rather than
# templating them, so any one of them can be read and submitted by hand:
#   air run --file air/21_qwen3_5_35b_fsdp_16gpu.yaml -p df2 --watch
# If you change catalog/schema/volume here, grep air/ and update to match.
# =============================================================================

# ---- Databricks -------------------------------------------------------------
# `databricks auth login --host <df2-url> --profile df2` must have been run.
AIR_PROFILE=df2

# ---- Docker Hub (private repo -> registration needs credentials) ------------
DOCKERHUB_USER=mshtelma
IMAGE_NAME=verl-megatron-air
IMAGE_TAG=v1
IMAGE=$(DOCKERHUB_USER)/$(IMAGE_NAME):$(IMAGE_TAG)

# ---- Unity Catalog ----------------------------------------------------------
UC_CATALOG=mshtelma
UC_SCHEMA=rlonair
UC_VOLUME=verl
VOL=/Volumes/$(UC_CATALOG)/$(UC_SCHEMA)/$(UC_VOLUME)

# ---- Image size gate --------------------------------------------------------
# AI Runtime DCS rejects images >20 GB (registration replication times out).
# `make size` fails above this, so we find out locally instead of 6 min into
# `air register image`.
MAX_IMAGE_GB=19.5
