logs/
*.log
__pycache__/
*.pyc
.venv/
wheelhouse/
.DS_Store

# Local agent/editor tool state (not for git)
.isaac/
.omc/

# air dry-run probes (scripts/validate_air_yaml.sh)
air/.probe_*.yaml

# Corporate CA bundles copied in by `make certs` (host-specific, not for git)
certs/*.crt
certs/*.pem
# Wheels/sources pre-fetched by `make vendor` for TLS-blocked networks
vendor/wheels/*.whl
vendor/src/*/

# Eval result artifacts (reproducible via the eval jobs; not committed to the template)
*_traces.jsonl
musique_pureem_*.json
eval_out/
